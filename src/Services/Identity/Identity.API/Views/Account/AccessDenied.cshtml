@{
    ViewData["Title"] = "Access Denied";
}

<div class="container-fluid" style="background: linear-gradient(135deg, #dc3545 0%, #c82333 100%); min-height: 90vh; padding: 50px 0;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="text-center text-white mb-5">
                    <i class="fas fa-exclamation-triangle" style="font-size: 4rem; margin-bottom: 20px;"></i>
                    <h1 class="display-4 fw-light">Access Denied</h1>
                    <p class="lead">You don't have permission to access this resource.</p>
                </div>

                <div class="card border-0 shadow">
                    <div class="card-body text-center p-4">
                        <h5 class="card-title text-danger">
                            <i class="fas fa-lock me-2"></i>
                            Insufficient Permissions
                        </h5>
                        <p class="card-text">
                            The resource you're trying to access requires specific permissions that your account doesn't have.
                        </p>
                        <hr>
                        <div class="d-grid gap-2 d-md-block">
                            <a href="/" class="btn btn-primary">
                                <i class="fas fa-home me-2"></i>Go Home
                            </a>
                            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary">
                                <i class="fas fa-sign-in-alt me-2"></i>Login with Different Account
                            </a>
                        </div>
                    </div>
                </div>

                @if (User.Identity.IsAuthenticated)
                {
                    <div class="card border-0 shadow mt-4">
                        <div class="card-header bg-info text-white">
                            <h6 class="card-title mb-0">
                                <i class="fas fa-info-circle me-2"></i>
                                Current User Information
                            </h6>
                        </div>
                        <div class="card-body">
                            <p><strong>Username:</strong> @User.Identity.Name</p>
                            <p><strong>User ID:</strong> @User.FindFirst("sub")?.Value</p>
                            @if (User.FindAll("role").Any())
                            {
                                <p><strong>Roles:</strong> @string.Join(", ", User.FindAll("role").Select(c => c.Value))</p>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
