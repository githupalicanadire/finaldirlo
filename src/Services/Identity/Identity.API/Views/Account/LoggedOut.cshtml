@model LoggedOutViewModel

<div class="logout-page">
    <div class="page-header">
        <h1>
            <i class="fa fa-sign-out"></i>
            Logout
            <small>You have been signed out</small>
        </h1>
    </div>

    <div class="row">
        <div class="col-sm-6 col-sm-offset-3">
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h3 class="panel-title">Logout Successful</h3>
                </div>
                <div class="panel-body">
                    <p>You have successfully logged out.</p>

                    @if (Model.PostLogoutRedirectUri != null)
                    {
                        <div>
                            <a class="btn btn-primary" href="@Model.PostLogoutRedirectUri">Return to @Model.ClientName</a>
                        </div>
                    }
                    else
                    {
                        <div>
                            <a class="btn btn-primary" href="/">Home</a>
                        </div>
                    }

                    @if (Model.SignOutIframeUrl != null)
                    {
                        <iframe width="0" height="0" class="signout-callback" src="@Model.SignOutIframeUrl"></iframe>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model.AutomaticRedirectAfterSignOut)
{
    <script>
        window.setTimeout(function () {
            @if (Model.PostLogoutRedirectUri != null)
            {
                <text>window.location = "@Model.PostLogoutRedirectUri";</text>
            }
            else
            {
                <text>window.location = "/";</text>
            }
        }, 3000);
    </script>
}
