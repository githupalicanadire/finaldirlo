@model ErrorViewModel

@{
    ViewData["Title"] = "Error";
}

<div class="container-fluid" style="background: linear-gradient(135deg, #dc3545 0%, #c82333 100%); min-height: 90vh; padding: 50px 0;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="text-center text-white mb-5">
                    <i class="fas fa-exclamation-circle" style="font-size: 4rem; margin-bottom: 20px;"></i>
                    <h1 class="display-4 fw-light">Oops! Something went wrong</h1>
                    <p class="lead">An error occurred while processing your request.</p>
                </div>

                @if (Model.Error != null)
                {
                    <div class="card border-0 shadow">
                        <div class="card-header bg-danger text-white">
                            <h5 class="card-title mb-0">
                                <i class="fas fa-bug me-2"></i>
                                Error Details
                            </h5>
                        </div>
                        <div class="card-body">
                            @if (!string.IsNullOrEmpty(Model.Error.Error))
                            {
                                <h6 class="text-danger">Error Type:</h6>
                                <p class="mb-3"><code>@Model.Error.Error</code></p>
                            }
                            
                            @if (!string.IsNullOrEmpty(Model.Error.ErrorDescription))
                            {
                                <h6 class="text-danger">Description:</h6>
                                <p class="mb-3">@Model.Error.ErrorDescription</p>
                            }
                            
                            @if (!string.IsNullOrEmpty(Model.Error.RequestId))
                            {
                                <h6 class="text-danger">Request ID:</h6>
                                <p class="mb-3"><code>@Model.Error.RequestId</code></p>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="card border-0 shadow">
                        <div class="card-body text-center p-4">
                            <h5 class="card-title text-danger">
                                <i class="fas fa-question-circle me-2"></i>
                                Unknown Error
                            </h5>
                            <p class="card-text">
                                An unexpected error occurred. Please try again later or contact support if the problem persists.
                            </p>
                        </div>
                    </div>
                }

                <div class="text-center mt-4">
                    <a href="/" class="btn btn-light btn-lg me-3">
                        <i class="fas fa-home me-2"></i>Go Home
                    </a>
                    <button onclick="history.back()" class="btn btn-outline-light btn-lg">
                        <i class="fas fa-arrow-left me-2"></i>Go Back
                    </button>
                </div>

                <!-- Development Info -->
                @if (ViewContext.HttpContext.Request.Query.ContainsKey("details"))
                {
                    <div class="card border-0 shadow mt-4">
                        <div class="card-header bg-warning text-dark">
                            <h6 class="card-title mb-0">
                                <i class="fas fa-tools me-2"></i>
                                Development Information
                            </h6>
                        </div>
                        <div class="card-body">
                            <p><strong>Request Path:</strong> @ViewContext.HttpContext.Request.Path</p>
                            <p><strong>User Agent:</strong> @ViewContext.HttpContext.Request.Headers["User-Agent"]</p>
                            <p><strong>Timestamp:</strong> @DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss UTC")</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
