@{
    ViewData["Title"] = "Welcome";
}

<div class="container-fluid" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); min-height: 90vh; padding: 50px 0;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="text-center text-white mb-5">
                    <h1 class="display-4 fw-light">
                        <i class="fas fa-shield-alt me-3"></i>
                        Identity Server
                    </h1>
                    <p class="lead">Centralized Authentication & Authorization for EShop Microservices</p>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-4">
                        <div class="card h-100 border-0 shadow">
                            <div class="card-body text-center p-4">
                                <div class="feature-icon bg-primary bg-gradient text-white rounded-circle mb-3 mx-auto" style="width: 60px; height: 60px; display: flex; align-items: center; justify-content: center;">
                                    <i class="fas fa-users fa-lg"></i>
                                </div>
                                <h5 class="card-title">User Management</h5>
                                <p class="card-text">Secure user registration, authentication, and profile management with role-based access control.</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6 mb-4">
                        <div class="card h-100 border-0 shadow">
                            <div class="card-body text-center p-4">
                                <div class="feature-icon bg-success bg-gradient text-white rounded-circle mb-3 mx-auto" style="width: 60px; height: 60px; display: flex; align-items: center; justify-content: center;">
                                    <i class="fas fa-key fa-lg"></i>
                                </div>
                                <h5 class="card-title">JWT Tokens</h5>
                                <p class="card-text">Stateless authentication using JWT tokens with proper scope and audience validation.</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6 mb-4">
                        <div class="card h-100 border-0 shadow">
                            <div class="card-body text-center p-4">
                                <div class="feature-icon bg-info bg-gradient text-white rounded-circle mb-3 mx-auto" style="width: 60px; height: 60px; display: flex; align-items: center; justify-content: center;">
                                    <i class="fas fa-cogs fa-lg"></i>
                                </div>
                                <h5 class="card-title">Microservices Security</h5>
                                <p class="card-text">Centralized authorization for all microservices with proper API scopes and resource protection.</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6 mb-4">
                        <div class="card h-100 border-0 shadow">
                            <div class="card-body text-center p-4">
                                <div class="feature-icon bg-warning bg-gradient text-white rounded-circle mb-3 mx-auto" style="width: 60px; height: 60px; display: flex; align-items: center; justify-content: center;">
                                    <i class="fas fa-database fa-lg"></i>
                                </div>
                                <h5 class="card-title">MongoDB Storage</h5>
                                <p class="card-text">Fast and scalable NoSQL database storage for users, roles, and Identity Server configuration.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Demo Users Info -->
                <div class="card border-0 shadow mt-4">
                    <div class="card-header bg-dark text-white">
                        <h5 class="card-title mb-0">
                            <i class="fas fa-info-circle me-2"></i>
                            Demo Accounts
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <h6 class="text-primary">Administrator</h6>
                                <ul class="list-unstyled">
                                    <li><strong>Username:</strong> admin</li>
                                    <li><strong>Password:</strong> admin123</li>
                                    <li><strong>Role:</strong> Admin</li>
                                </ul>
                            </div>
                            <div class="col-md-6">
                                <h6 class="text-success">Customer</h6>
                                <ul class="list-unstyled">
                                    <li><strong>Username:</strong> customer</li>
                                    <li><strong>Password:</strong> customer123</li>
                                    <li><strong>Role:</strong> Customer</li>
                                </ul>
                            </div>
                        </div>
                        <div class="row mt-3">
                            <div class="col-md-6">
                                <h6 class="text-info">Demo User</h6>
                                <ul class="list-unstyled">
                                    <li><strong>Username:</strong> demo</li>
                                    <li><strong>Password:</strong> demo123</li>
                                    <li><strong>Role:</strong> User</li>
                                </ul>
                            </div>
                            <div class="col-md-6">
                                <h6 class="text-warning">Tester</h6>
                                <ul class="list-unstyled">
                                    <li><strong>Username:</strong> test</li>
                                    <li><strong>Password:</strong> test123</li>
                                    <li><strong>Role:</strong> Tester</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Quick Actions -->
                <div class="text-center mt-4">
                    @if (!User.Identity.IsAuthenticated)
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-light btn-lg me-3">
                            <i class="fas fa-sign-in-alt me-2"></i>Login
                        </a>
                        <a asp-controller="Account" asp-action="Register" class="btn btn-outline-light btn-lg">
                            <i class="fas fa-user-plus me-2"></i>Register
                        </a>
                    }
                    else
                    {
                        <div class="alert alert-success">
                            <i class="fas fa-check-circle me-2"></i>
                            Welcome back, <strong>@User.Identity.Name</strong>!
                        </div>
                        <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-light btn-lg">
                            <i class="fas fa-sign-out-alt me-2"></i>Logout
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Service Endpoints Info -->
<div class="container py-5">
    <div class="row">
        <div class="col-12">
            <h3 class="text-center mb-4">Connected Services</h3>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <div class="card border-primary">
                        <div class="card-header bg-primary text-white">
                            <i class="fas fa-shopping-cart me-2"></i>Shopping Web
                        </div>
                        <div class="card-body">
                            <p class="card-text">Main e-commerce frontend application</p>
                            <a href="http://localhost:6005" class="btn btn-outline-primary btn-sm" target="_blank">
                                <i class="fas fa-external-link-alt me-1"></i>Visit
                            </a>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card border-success">
                        <div class="card-header bg-success text-white">
                            <i class="fas fa-gateway me-2"></i>API Gateway
                        </div>
                        <div class="card-body">
                            <p class="card-text">YARP reverse proxy and API gateway</p>
                            <a href="http://localhost:6004" class="btn btn-outline-success btn-sm" target="_blank">
                                <i class="fas fa-external-link-alt me-1"></i>Visit
                            </a>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card border-info">
                        <div class="card-header bg-info text-white">
                            <i class="fas fa-database me-2"></i>MongoDB Admin
                        </div>
                        <div class="card-body">
                            <p class="card-text">Database administration interface</p>
                            <a href="http://localhost:8081" class="btn btn-outline-info btn-sm" target="_blank">
                                <i class="fas fa-external-link-alt me-1"></i>Visit
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
