<div class="container">
    <div class="jumbotron">
        <h1>Identity Server</h1>
        <p>Welcome to the Identity Server for EShop Microservices</p>
        
        @if (User.Identity.IsAuthenticated)
        {
            <p>Welcome <strong>@User.Identity.Name</strong></p>
            <a href="/Account/Logout" class="btn btn-secondary">Logout</a>
        }
        else
        {
            <a href="/Account/Login" class="btn btn-primary">Login</a>
        }
    </div>
    
    <div class="row">
        <div class="col-md-12">
            <h3>Demo Users</h3>
            <ul>
                <li><strong>admin</strong> / admin123 (Admin Role)</li>
                <li><strong>customer</strong> / customer123 (Customer Role)</li>
            </ul>
        </div>
    </div>
</div>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
