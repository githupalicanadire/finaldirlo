{
  "MongoDbSettings": {
    "ConnectionString": "mongodb://identitydb:27017",
    "DatabaseName": "IdentityServerDb",
    "UsersCollectionName": "Users",
    "RolesCollectionName": "Roles",
    "ClientsCollectionName": "Clients",
    "IdentityResourcesCollectionName": "IdentityResources",
    "ApiResourcesCollectionName": "ApiResources",
    "ApiScopesCollectionName": "ApiScopes",
    "PersistedGrantsCollectionName": "PersistedGrants",
    "DeviceFlowCodesCollectionName": "DeviceFlowCodes"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "IdentityServer4": "Information"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning",
        "IdentityServer4": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/identity-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "MongoDB",
        "Args": {
          "databaseUrl": "mongodb://identitydb:27017/IdentityServerDb",
          "collectionName": "ApplicationLogs"
        }
      }
    ]
  }
}
