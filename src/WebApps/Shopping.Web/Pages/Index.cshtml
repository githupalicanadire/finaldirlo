@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="container py-5">
    <!-- Hero Section -->
    <div class="row mb-5">
        <div class="col-md-12">
            <div class="hero-card position-relative overflow-hidden">
                <div class="hero-background"></div>
                <div class="hero-content p-5">
                    <div class="row align-items-center">
                        <div class="col-md-6">
                            <h1 class="hero-title mb-3">Welcome to ToyShop</h1>
                            <p class="hero-subtitle mb-4">Discover our amazing collection of toys and games that bring joy to all ages. Experience the magic of play with our premium quality products.</p>
                            <div class="hero-buttons">
                                <a asp-page="ProductList" class="btn btn-hero btn-lg me-3">
                                    <i class="fas fa-shopping-bag me-2"></i>Shop Now
                                </a>
                                <a asp-page="ProductList" class="btn btn-hero-outline btn-lg">
                                    <i class="fas fa-heart me-2"></i>Explore
                                </a>
                            </div>
                        </div>
                        <div class="col-md-6 text-center">
                            <div class="hero-icon-container">
                                <i class="fas fa-store hero-icon"></i>
                                <div class="icon-glow"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Categories Section -->
    <div class="row mb-5">
        <div class="col-12">
            <h2 class="section-title mb-5">
                <span class="title-text">Shop by Category</span>
                <span class="title-decoration"></span>
            </h2>
        </div>
        @foreach (var category in Model.Categories)
        {
            <div class="col-md-4 mb-4">
                <div class="category-card glass-card h-100">
                    <div class="category-card-inner text-center p-4">
                        <div class="category-icon-wrapper">
                            <i class="fas fa-puzzle-piece category-icon"></i>
                            <div class="icon-ripple"></div>
                        </div>
                        <h5 class="category-title">@category</h5>
                        <a asp-page="ProductList" asp-route-categoryName="@category" class="btn btn-category mt-3">
                            <span>View Products</span>
                            <i class="fas fa-arrow-right ms-2"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Features Section -->
    <div class="row mb-5">
        <div class="col-12">
            <h2 class="section-title mb-5">
                <span class="title-text">Why Choose Us</span>
                <span class="title-decoration"></span>
            </h2>
        </div>
        <div class="col-md-4 mb-4">
            <div class="feature-card glass-card h-100">
                <div class="feature-card-inner text-center p-4">
                    <div class="feature-icon-wrapper">
                        <i class="fas fa-truck feature-icon"></i>
                        <div class="feature-bg-icon fas fa-truck"></div>
                    </div>
                    <h5 class="feature-title">Fast Delivery</h5>
                    <p class="feature-text">Quick and reliable shipping to your doorstep with real-time tracking.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="feature-card glass-card h-100">
                <div class="feature-card-inner text-center p-4">
                    <div class="feature-icon-wrapper">
                        <i class="fas fa-shield-alt feature-icon"></i>
                        <div class="feature-bg-icon fas fa-shield-alt"></div>
                    </div>
                    <h5 class="feature-title">Secure Shopping</h5>
                    <p class="feature-text">Safe and secure payment processing with end-to-end encryption.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="feature-card glass-card h-100">
                <div class="feature-card-inner text-center p-4">
                    <div class="feature-icon-wrapper">
                        <i class="fas fa-headset feature-icon"></i>
                        <div class="feature-bg-icon fas fa-headset"></div>
                    </div>
                    <h5 class="feature-title">24/7 Support</h5>
                    <p class="feature-text">Always here to help you with expert support and quick solutions.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-gradient-primary {
        background: linear-gradient(45deg, var(--primary-color), var(--accent-color));
    }

    .card {
        transition: transform 0.3s ease;
    }

    .card:hover {
        transform: translateY(-5px);
    }

    .btn-outline-primary {
        color: var(--primary-color);
        border-color: var(--primary-color);
    }

    .btn-outline-primary:hover {
        background-color: var(--primary-color);
        border-color: var(--primary-color);
        color: white;
    }

    .btn-light {
        background-color: white;
        color: var(--primary-color);
        border: none;
    }

    .btn-light:hover {
        background-color: var(--primary-color);
        color: white;
    }
</style>
