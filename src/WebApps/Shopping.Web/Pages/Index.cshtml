@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="container py-4">
    <!-- Hero Section -->
    <div class="row mb-5">
        <div class="col-md-12">
            <div class="card border-0 shadow-sm overflow-hidden">
                <div class="position-relative">
                    <div class="bg-gradient-primary p-5 text-white">
                        <div class="row align-items-center">
                            <div class="col-md-6">
                                <h1 class="display-4 fw-bold mb-3">Welcome to ToyShop</h1>
                                <p class="lead mb-4">Discover our amazing collection of toys and games for all ages.</p>
                                <a asp-page="ProductList" class="btn btn-light btn-lg">
                                    <i class="fas fa-shopping-bag me-2"></i>Shop Now
                                </a>
                            </div>
                            <div class="col-md-6 text-center">
                                <i class="fas fa-store fa-6x mb-3"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Categories Section -->
    <div class="row mb-5">
        <div class="col-12">
            <h2 class="mb-4">Shop by Category</h2>
        </div>
        @foreach (var category in Model.Categories)
        {
            <div class="col-md-4 mb-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center p-4">
                        <i class="fas fa-puzzle-piece fa-3x mb-3" style="color: var(--primary-color)"></i>
                        <h5 class="card-title">@category</h5>
                        <a asp-page="ProductList" asp-route-categoryName="@category" class="btn btn-outline-primary mt-3">
                            View Products
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Features Section -->
    <div class="row mb-5">
        <div class="col-12">
            <h2 class="mb-4">Why Choose Us</h2>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center p-4">
                    <i class="fas fa-truck fa-3x mb-3" style="color: var(--primary-color)"></i>
                    <h5 class="card-title">Fast Delivery</h5>
                    <p class="card-text">Quick and reliable shipping to your doorstep.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center p-4">
                    <i class="fas fa-shield-alt fa-3x mb-3" style="color: var(--primary-color)"></i>
                    <h5 class="card-title">Secure Shopping</h5>
                    <p class="card-text">Safe and secure payment processing.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center p-4">
                    <i class="fas fa-headset fa-3x mb-3" style="color: var(--primary-color)"></i>
                    <h5 class="card-title">24/7 Support</h5>
                    <p class="card-text">Always here to help you with any questions.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-gradient-primary {
        background: linear-gradient(45deg, var(--primary-color), var(--accent-color));
    }

    .card {
        transition: transform 0.3s ease;
    }

    .card:hover {
        transform: translateY(-5px);
    }

    .btn-outline-primary {
        color: var(--primary-color);
        border-color: var(--primary-color);
    }

    .btn-outline-primary:hover {
        background-color: var(--primary-color);
        border-color: var(--primary-color);
        color: white;
    }

    .btn-light {
        background-color: white;
        color: var(--primary-color);
        border: none;
    }

    .btn-light:hover {
        background-color: var(--primary-color);
        color: white;
    }
</style>
